# Local development values only. Never place production secrets here.
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_local_keycloak_admin
KEYCLOAK_DB_PASSWORD=CHANGE_ME_local_keycloak_db
USER_DB_PASSWORD=CHANGE_ME_local_user_db
MAINTENANCE_DB_PASSWORD=CHANGE_ME_local_maintenance_db
SUPPORT_DB_PASSWORD=CHANGE_ME_local_support_db
NOTIFICATION_DB_PASSWORD=CHANGE_ME_local_notification_db
QUOTATION_DB_PASSWORD=CHANGE_ME_local_quotation_db
ORDER_DB_PASSWORD=CHANGE_ME_local_order_db
CART_DB_PASSWORD=CHANGE_ME_local_cart_db
WISHLIST_DB_PASSWORD=CHANGE_ME_local_wishlist_db
PRODUCT_DB_PASSWORD=CHANGE_ME_local_product_db

# Host-side Spring clients use localhost:29092. Docker-profile clients default to kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Create an OAuth 2.0 Web application in Google Cloud Console. These are fake examples.
# Local authorized redirect URI: http://localhost:8180/realms/wwtrading/broker/google/endpoint
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=example-google-secret

# Local observability console. Replace these fake values before starting Compose.
GRAFANA_ADMIN_USER=admin-example
GRAFANA_ADMIN_PASSWORD=change-me-locally
# Required shared credential for notification-service -> user-service recipient lookup.
NOTIFICATION_INTERNAL_KEY=replace-with-a-long-random-development-secret

# Frontend public base URL for customer links (e.g. order tracking, email CTAs).
# Defaults to http://localhost:4201 in development. In production set to your VM IP or HTTPS domain:
# FRONTEND_PUBLIC_URL=http://74.248.151.43
FRONTEND_PUBLIC_URL=http://localhost:4201
TRACKING_BASE_URL=http://localhost:4201

# Production Frontend Configuration (Azure VM - Native Node.js Static & Proxy Server)
# In local development: frontend runs on host with 'pnpm start' (port 4201).
# In production on Azure VM: frontend runs in Docker with Node.js on port 80.
FRONTEND_HTTP_PORT=80
FRONTEND_API_BASE_URL=
KEYCLOAK_PUBLIC_URL=http://74.248.151.43
ALLOWED_ORIGINS=http://74.248.151.43,http://localhost:4201

# Production SMTP configuration (leave commented in local dev to use MailHog).
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=smtp-username-example
# MAIL_PASSWORD=smtp-password-example
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# ==============================================================================
# PostgreSQL Backup Restoration Configuration (Docker Workflow)
# ==============================================================================
# Safety default: false. When set to 'true', fresh empty databases will auto-restore
# their corresponding .dump file from ./backups during their initial container startup.
# Existing databases with data are NEVER overwritten (Mode B safety).
ENABLE_BACKUP_RESTORE=false
BACKUP_RESTORE_MODE=initial-empty-database
BACKUP_DIRECTORY=/backups
