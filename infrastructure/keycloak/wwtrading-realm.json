{
  "realm": "wwtrading",
  "enabled": true,
  "sslRequired": "external",
  "displayName": "WWTRADING",
  "loginTheme": "wwtrading",
  "accountTheme": "wwtrading",
  "emailTheme": "wwtrading",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "eventsListeners": ["jboss-logging", "client-role-assigner"],
  "loginWithEmailAllowed": true,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1) and specialChars(1)",
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@wwtrading.ma",
    "fromDisplayName": "WWTRADING Security",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Platform administrator" },
      { "name": "MANAGER", "description": "Business manager" },
      { "name": "COMMERCIAL", "description": "Sales representative" },
      { "name": "TECHNICIAN", "description": "Field technician" },
      { "name": "CLIENT", "description": "Business customer" },
      {
        "name": "default-roles-wwtrading",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "CLIENT"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Continue with Google",
      "providerId": "google",
      "enabled": true,
      "storeToken": false,
      "trustEmail": true,
      "linkOnly": false,
      "authenticateByDefault": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true",
        "hideOnLogin": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "Assign CLIENT to Google users",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "role": "CLIENT",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clients": [
    {
      "clientId": "wwtrading-api",
      "name": "WWTRADING API audience",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "wwtrading-web",
      "name": "WWTRADING Angular Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4201/*",
        "http://74.248.151.43/*",
        "https://indexed-arizona-sun-treated.trycloudflare.com/*"
      ],
      "webOrigins": [
        "http://localhost:4201",
        "http://74.248.151.43",
        "https://indexed-arizona-sun-treated.trycloudflare.com",
        "+"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["wwtrading-identity", "wwtrading-api-audience"]
    },
    {
      "clientId": "user-service-client",
      "name": "WWTRADING User Service M2M",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${USER_SERVICE_KEYCLOAK_CLIENT_SECRET}",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "defaultClientScopes": ["wwtrading-identity", "wwtrading-api-audience"]
    }
  ],
  "clientScopes": [
    {
      "name": "wwtrading-identity",
      "description": "Identity claims and WWTRADING realm roles required by the platform",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "locale",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "locale",
            "claim.name": "locale",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "phone",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phone",
            "claim.name": "phone_number",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "wwtrading-api-audience",
      "description": "Adds the WWTRADING API audience to access tokens",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        {
          "name": "wwtrading-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wwtrading-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["wwtrading-identity", "wwtrading-api-audience"],
  "users": [
    {
      "username": "service-account-user-service-client",
      "enabled": true,
      "serviceAccountClientId": "user-service-client",
      "clientRoles": {
        "realm-management": ["view-users", "view-realm", "manage-users"]
      }
    }
  ]
}
